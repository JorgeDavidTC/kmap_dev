CREATE USER IF NOT EXISTS 'mka_app'@'%'
  IDENTIFIED BY 'CAMBIAR_CLAVE_FUERTE_APP_2024!';

GRANT SELECT, INSERT, UPDATE, DELETE
  ON kmap.* TO 'mka_app'@'%';

GRANT EXECUTE ON PROCEDURE kmap.sp_validar_prerrequisito TO 'mka_app'@'%';

-- G.2 Reportería: solo lectura
CREATE USER IF NOT EXISTS 'mka_readonly'@'%'
  IDENTIFIED BY 'CAMBIAR_CLAVE_FUERTE_READONLY_2024!';

GRANT SELECT ON kmap.* TO 'mka_readonly'@'%';

-- G.3 Migraciones: DDL, solo desde localhost
CREATE USER IF NOT EXISTS 'mka_migrator'@'localhost'
  IDENTIFIED BY 'CAMBIAR_CLAVE_FUERTE_MIGRATOR_2024!';

GRANT ALL PRIVILEGES ON kmap.* TO 'mka_migrator'@'localhost';

FLUSH PRIVILEGES;